# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- User/permissions ---
PUID=1000
PGID=1000
TZ=America/Toronto

# --- Paths (host machine) ---
# Quote any path containing a space. Docker Compose and setup.sh both strip
# the quotes; leaving them off makes the value ambiguous to shell tooling.
# Root folder where each container's persistent config lives
DATA_ROOT="/home/jordan/arrstack-data"
# Where finished downloads land before Sonarr/Radarr import them
DOWNLOADS_PATH="/home/jordan/Downloads/torrents"
# Media library roots
TV_PATH="/home/jordan/Videos/Tv Shows"
MOVIES_PATH="/home/jordan/Videos/Movies"

# --- Networking ---
# Subnet for the shared 'arrstack' docker network.
# Must match what you allowlist in NordVPN (see README).
ARRSTACK_SUBNET=172.20.0.0/16
# Optional. Your real LAN subnet, e.g. 192.168.1.0/24. Only needed if you set
# userland-proxy=false in Docker's daemon.json — without it, LAN clients reach
# gluetun with their real source IP and its firewall drops them.
LAN_SUBNET=

# --- Gluetun / NordVPN ---
# WireGuard private key from your NordVPN account (NOT your login password).
# See README for how to generate it.
WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRY=Canada

# --- Plex ---
# One-time claim token from https://plex.tv/claim (expires in ~4 min).
# Only needed the FIRST time you bring this server up. Leave blank after
# the initial run — Plex is already linked at that point.
PLEX_CLAIM=

# --- Image tags ---
# Blank/unset means :latest, which is what this stack used to do implicitly.
# Pin them once you have a working stack so `docker compose pull` can't walk
# you across a breaking major with nothing to roll back to. Get the versions
# you're currently running with:  docker compose images
GLUETUN_TAG=
QBITTORRENT_TAG=
PROWLARR_TAG=
SONARR_TAG=
RADARR_TAG=
SEERR_TAG=
PLEX_TAG=
