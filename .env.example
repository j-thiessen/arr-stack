# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- User/permissions ---
PUID=1000
PGID=1000
TZ=America/Toronto

# --- Paths (host machine) ---
# Quote any path containing a space. Docker Compose and setup.sh both strip
# the quotes; leaving them off makes the value ambiguous to shell tooling.
# Root folder where each container's persistent config lives
DATA_ROOT="/home/jordan/arrstack-data"
# Where finished downloads land before Sonarr/Radarr import them
DOWNLOADS_PATH="/home/jordan/Downloads/torrents"
# Media library roots
TV_PATH="/home/jordan/Videos/Tv Shows"
MOVIES_PATH="/home/jordan/Videos/Movies"

# --- Networking ---
# Subnet for the shared 'arrstack' docker network.
# Must match what you allowlist in NordVPN (see README).
ARRSTACK_SUBNET=172.20.0.0/16
# Optional. Your real LAN subnet, e.g. 192.168.1.0/24. Only needed if you set
# userland-proxy=false in Docker's daemon.json — without it, LAN clients reach
# gluetun with their real source IP and its firewall drops them.
LAN_SUBNET=

# --- Gluetun / NordVPN ---
# WireGuard private key from your NordVPN account (NOT your login password).
# See README for how to generate it.
WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRY=Canada

# --- Plex ---
# One-time claim token from https://plex.tv/claim (expires in ~4 min).
# Only needed the FIRST time you bring this server up. Leave blank after
# the initial run — Plex is already linked at that point.
PLEX_CLAIM=

# --- Homepage dashboard ---
# Host port for the dashboard. Change it if something already owns :80
# (check with: sudo ss -lntp | grep ':80 ').
HOMEPAGE_PORT=80
# REQUIRED. Homepage rejects any request whose Host header isn't listed
# here, and the failure looks like a blank page rather than an error.
# List every host:port you'll actually type. On port 80 that's a bare
# host with no port. Comma-separated.
HOMEPAGE_ALLOWED_HOSTS=localhost,192.168.1.50
# This machine's LAN IP. Tile links and the Plex widget need an address
# your BROWSER can reach — container names don't resolve off the bridge.
LAN_IP=192.168.1.50

# API keys for the dashboard widgets. Blank is fine: that widget just
# renders empty and everything else still works, so fill them in as you go.
# Sonarr/Radarr/Prowlarr: Settings > General > Security > API Key
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
# Seerr: Settings > General > API Key
SEERR_API_KEY=
# Plex: https://support.plex.tv/articles/204059436 (X-Plex-Token)
PLEX_TOKEN=
# qBittorrent WebUI login (the permanent one you set, not the temp password)
QBT_USERNAME=
QBT_PASSWORD=

# --- Image tags ---
# Blank/unset means :latest, which is what this stack used to do implicitly.
# Pin them once you have a working stack so `docker compose pull` can't walk
# you across a breaking major with nothing to roll back to. Get the versions
# you're currently running with:  docker compose images
GLUETUN_TAG=
QBITTORRENT_TAG=
PROWLARR_TAG=
SONARR_TAG=
RADARR_TAG=
SEERR_TAG=
PLEX_TAG=
HOMEPAGE_TAG=
DOCKERPROXY_TAG=
