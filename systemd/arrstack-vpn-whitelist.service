[Unit]
Description=Re-apply NordVPN whitelist for arrstack docker network
After=network-online.target nordvpnd.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Adjust the subnet below if you changed ARRSTACK_SUBNET in .env
ExecStart=/usr/bin/nordvpn whitelist add subnet 172.20.0.0/16
ExecStart=/usr/bin/nordvpn whitelist add port 32400

[Install]
WantedBy=multi-user.target
