[Unit]
Description=Re-apply NordVPN network settings (allowlist, LAN discovery, firewall) for arrstack + Plex
After=network-online.target nordvpnd.service docker.service
# Wants=, not just After=: After= only orders the unit, it does not pull
# nordvpnd into the boot transaction.
Wants=network-online.target nordvpnd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Subnet lives here so it stays in sync with .env — setup.sh writes it.
# The leading '-' makes the file optional; the script defaults to
# 172.20.0.0/16 when it is absent.
EnvironmentFile=-/etc/default/arrstack
ExecStart=/usr/local/bin/arrstack-vpn-apply.sh
# The script only fails when nordvpnd never became reachable, which is worth
# retrying; already-applied rules are not failures.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
